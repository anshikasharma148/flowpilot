# Copy to backend/.env and fill in what you need. Everything is optional.

# --- LLM. Set ONE of the keys below. Without any key the platform runs in rule-based mode. ---
# Google Gemini (free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash
# Anthropic Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# auto = Claude if its key is set, else Gemini if its key is set | anthropic | gemini
LLM_PROVIDER=auto
# auto = use the LLM when a key exists | rules = never call the LLM
LLM_MODE=auto

# --- Defaults ---
TIMEZONE=Asia/Kolkata
# DATABASE_URL=sqlite:///./workflow.db   (any SQLAlchemy URL, e.g. postgresql+psycopg://user:pw@host/db)

# --- Email (REQUIRED for email steps; configure ONE provider) ---
# Option A - Gmail SMTP (easiest locally): enable 2-Step Verification, then create an App Password at
#            https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Option B - Brevo HTTPS API (use on hosts that block outgoing SMTP, e.g. many free tiers):
#            free account at https://www.brevo.com -> SMTP & API -> API keys; verify your sender address.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=FlowPilot
# auto = Brevo if BREVO_API_KEY is set, else SMTP | brevo | smtp
EMAIL_PROVIDER=auto
# Real address used when a request says "email the operations team"
OPS_TEAM_EMAIL=

# --- Jira Cloud (REQUIRED for real tickets; without it tickets go to the local table) ---
# Free site: https://www.atlassian.com/software/jira/free . API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=OPS
JIRA_ISSUE_TYPE=Task
